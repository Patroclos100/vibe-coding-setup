{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["module_id", "version", "status", "reuse_policy"],
  "properties": {
    "module_id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "approved", "deprecated"]},
    "reuse_policy": {"type": "string", "enum": ["mandatory", "preferred", "optional", "forbidden"]}
  },
  "additionalProperties": true
}
