{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/runtime-output.schema.json",
  "title": "VibeCoding Runtime Output",
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "command",
    "status",
    "current_scope",
    "inputs_used",
    "files",
    "acceptance",
    "risks",
    "validation",
    "state_updates",
    "remaining_out_of_scope",
    "next_action"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/\\\\-]+$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "statusEnum": {
      "type": "string",
      "enum": [
        "success",
        "blocked",
        "failed",
        "needs_input"
      ]
    },
    "checkStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "pending"
      ]
    },
    "risk": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "mitigated",
            "blocked"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "criterion_id",
        "planned_verification",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "planned_verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "unit",
              "integration",
              "e2e",
              "lint",
              "typecheck",
              "build",
              "smoke",
              "manual"
            ]
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "covered",
            "passed",
            "failed"
          ]
        }
      }
    },
    "validationResult": {
      "type": "object",
      "required": [
        "check_id",
        "status",
        "details"
      ],
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/checkStatus"
        },
        "details": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "agent": {
      "type": "string",
      "pattern": "^vc-[a-z-]+$"
    },
    "command": {
      "type": "string",
      "pattern": "^/[a-z-]+$"
    },
    "status": {
      "$ref": "#/$defs/statusEnum"
    },
    "current_scope": {
      "type": "object",
      "required": [
        "summary",
        "in_scope",
        "out_of_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "in_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "inputs_used": {
      "type": "object",
      "required": [
        "contracts",
        "specs",
        "state_files",
        "stack"
      ],
      "additionalProperties": false,
      "properties": {
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "specs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "state_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "stack": {
          "type": "string",
          "enum": [
            "sveltekit-web",
            "fastapi-api",
            "python-automation"
          ]
        }
      }
    },
    "files": {
      "type": "object",
      "required": [
        "to_change",
        "changed"
      ],
      "additionalProperties": false,
      "properties": {
        "to_change": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "criteria_ids",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "criteria_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coverage"
          }
        }
      }
    },
    "risks": {
      "type": "object",
      "required": [
        "assumptions",
        "open"
      ],
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "open": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "required_checks",
        "executed_checks",
        "results"
      ],
      "additionalProperties": false,
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "executed_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationResult"
          }
        }
      }
    },
    "state_updates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "remaining_out_of_scope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "next_action": {
      "$ref": "#/$defs/nonEmptyString"
    }
  }
}
