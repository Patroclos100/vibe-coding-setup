{
  "factory": "vibecoding-ai-factory",
  "pipelines": [
    {
      "id": "intake",
      "workflow": ".ai/workflows/executable/intake.workflow.json",
      "stages": [
        "normalize-intake",
        "select-blueprint",
        "initialize-project"
      ]
    },
    {
      "id": "module-delivery",
      "workflow": ".ai/workflows/executable/build-module.workflow.json",
      "stages": [
        "plan-module",
        "build-module",
        "run-quality-gates"
      ]
    },
    {
      "id": "release-delivery",
      "workflow": ".ai/workflows/executable/release.workflow.json",
      "stages": [
        "prepare-release",
        "run-release-gates",
        "record-deployment"
      ]
    }
  ]
}
